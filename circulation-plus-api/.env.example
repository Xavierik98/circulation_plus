# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# CORS — origines Flutter autorisées (séparées par des virgules)
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/circulation_plus

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_min_32_chars_long_too

# SMS — Africa's Talking (laisser vide => mode stub)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=CirculationPlus

# Mobile Money — CinetPay (laisser vide => mode stub)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=

# Firebase FCM (laisser vide => mode stub)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Cloudflare R2 (laisser vide => mode stub local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=circulation-plus-pdfs
R2_PUBLIC_URL=

# Répartition financière (XAF)
# PART_DEVELOPPEUR : 1 000 XAF fixe par contravention → compte développeurs
# Le reste (montantAmende) est réparti selon les poids AGENT/POLICE/TRESOR
PART_DEVELOPPEUR=1000
PART_AGENT=0
PART_POLICE=0
PART_TRESOR=0

# Comptes Mobile Money de versement automatique après confirmation paiement
# COMPTE_DEVELOPPEUR : numéro MTN/Airtel qui reçoit les 1 000 XAF devs
# COMPTE_POLICE      : numéro qui reçoit la part amende officielle
COMPTE_DEVELOPPEUR=+242XXXXXXXXX
COMPTE_POLICE=+242XXXXXXXXX

# Convocations
DELAI_CONVOCATION_JOURS=7
DELAI_RELANCE_JOURS=14
