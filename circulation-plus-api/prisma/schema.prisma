generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums applicatifs (invariants) ────────────────────────────────────────────

enum Role {
  POLICE
  CITOYEN
  ADMIN
}

/// Niveau hiérarchique fonctionnel : détermine la portée des données accessibles.
enum NiveauHierarchique {
  DIRECTION_GENERALE   // Voit tout (national)
  DIRECTION_NATIONALE  // Voit son domaine national (DSP, DPJ…)
  DIRECTION_DEPT       // Voit son département
  COMMISSARIAT_CENTRAL // Voit les unités sous sa juridiction
  COMMISSARIAT_ZONE    // Voit son commissariat uniquement
  AGENT                // Voit ses propres données seulement
}

enum FineStatus {
  PENDING
  PAID
  OVERDUE
  CONTESTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum ConvocationStatus {
  PENDING
  SMS1_SENT
  SMS2_SENT
  APPEARED
  DEFAULTER
}

enum PaymentMode {
  MOBILE_MONEY
  TRESOR_PUBLIC
}

enum SanctionType {
  AVERTISSEMENT
  BLAME
  SUSPENSION_TEMPORAIRE
  REVOCATION
}

// ── Organisation PNC Congo ─────────────────────────────────────────────────────

/// Direction Générale de la Police Nationale (1 — DGPN).
model DirectionGenerale {
  id        String   @id @default(uuid())
  nom       String
  code      String   @unique // "DGPN"
  adresse   String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directionsNationales DirectionNationale[]
}

/// 7 Directions Nationales spécialisées (DSP, DPJ, DPAF, DCRP, DCI, DST, DRSP).
model DirectionNationale {
  id                  String            @id @default(uuid())
  nom                 String
  sigle               String            @unique // DSP, DPJ, DPAF…
  description         String?
  directionGeneraleId String
  directionGenerale   DirectionGenerale @relation(fields: [directionGeneraleId], references: [id])
  actif               Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  agents User[]

  @@index([directionGeneraleId])
}

/// 12 départements géographiques de la République du Congo.
model Departement {
  id        String   @id @default(uuid())
  nom       String
  code      String   @unique // BRAZZAVILLE, POINTE_NOIRE, etc.
  chefLieu  String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directionDepartementale DirectionDepartementale?
  commissariats           Commissariat[]
  agents                  User[]

  @@index([code])
}

/// Direction Départementale de Sécurité Publique — une par département.
model DirectionDepartementale {
  id            String      @id @default(uuid())
  nom           String
  code          String      @unique // DD-BZV, DD-PNR, etc.
  adresse       String?
  lat           Float?
  lng           Float?
  departementId String      @unique
  departement   Departement @relation(fields: [departementId], references: [id])
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  commissariats Commissariat[]
  agents        User[]

  @@index([departementId])
}

/// 52 commissariats de la République du Congo.
model Commissariat {
  id                        String                   @id @default(uuid())
  nom                       String
  code                      String                   @unique
  adresse                   String?
  lat                       Float?
  lng                       Float?
  departementId             String
  departement               Departement              @relation(fields: [departementId], references: [id])
  directionDepartementaleId String?
  directionDepartementale   DirectionDepartementale? @relation(fields: [directionDepartementaleId], references: [id])
  actif                     Boolean                  @default(true)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  unites Unite[]
  agents User[]

  @@index([departementId])
  @@index([directionDepartementaleId])
}

/// 96 unités opérationnelles au sein des commissariats (BSP, BPJ, BCR, BIR, BMO, BAF…).
model Unite {
  id             String       @id @default(uuid())
  nom            String
  sigle          String       // BSP, BPJ, BCR, BIR, BMO, BAF
  code           String       @unique
  commissariatId String
  commissariat   Commissariat @relation(fields: [commissariatId], references: [id])
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agents User[]

  @@index([commissariatId])
}

/// 12 grades officiels de la Police Nationale Congolaise.
model Grade {
  id        String  @id @default(uuid())
  nom       String
  code      String  @unique // GARDIEN_DE_LA_PAIX_2CL … DIRECTEUR_GENERAL
  sigle     String?
  niveau    Int     // 1 (entrée) → 12 (DG) — sert au tri
  categorie String  // Gardien · Sous-officier · Officier · Off. supérieur · Direction
  actif     Boolean @default(true)

  agents User[]

  @@index([niveau])
}

// ── RBAC ──────────────────────────────────────────────────────────────────────

/// 8 rôles applicatifs (SUPERADMIN → LECTEUR).
model AppRole {
  id          String   @id @default(uuid())
  nom         String
  code        String   @unique
  description String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  agents          User[]
}

/// 15 permissions RBAC.
model Permission {
  id          String @id @default(uuid())
  nom         String
  code        String @unique // officers:create, fines:read, etc.
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  appRoleId    String
  appRole      AppRole    @relation(fields: [appRoleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([appRoleId, permissionId])
  @@index([appRoleId])
}

// ── Utilisateur ───────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  pinHash     String
  role        Role
  name        String
  badgeNumber String? @unique
  telephone   String?

  actif                  Boolean  @default(true)
  mustChangePassword     Boolean  @default(false)
  emailVerified          Boolean  @default(true)
  emailVerificationToken String?  @unique
  fcmToken               String?
  photoUrl               String?

  /// Niveau hiérarchique fonctionnel : contrôle la portée des données visibles.
  niveauHierarchique NiveauHierarchique @default(AGENT)

  // Affectation organisationnelle
  gradeId                   String?
  grade                     Grade?                   @relation(fields: [gradeId], references: [id])
  departementId             String?
  departement               Departement?             @relation(fields: [departementId], references: [id])
  directionNationaleId      String?
  directionNationale        DirectionNationale?      @relation(fields: [directionNationaleId], references: [id])
  directionDepartementaleId String?
  directionDepartementale   DirectionDepartementale? @relation(fields: [directionDepartementaleId], references: [id])
  commissariatId            String?
  commissariat              Commissariat?            @relation(fields: [commissariatId], references: [id])
  uniteId                   String?
  unite                     Unite?                   @relation(fields: [uniteId], references: [id])
  appRoleId                 String?
  appRole                   AppRole?                 @relation(fields: [appRoleId], references: [id])

  onDuty     Boolean   @default(false)
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finesAsOfficer  Fine[]         @relation("OfficerFines")
  finesAsCitizen  Fine[]         @relation("CitizenFines")
  notifications   Notification[]
  auditLogs       AuditLog[]
  sanctionsRecues Sanction[]     @relation("OfficerSanctions")
  sanctionsEmises Sanction[]     @relation("AdminSanctions")

  @@index([email])
  @@index([badgeNumber])
  @@index([commissariatId])
  @@index([niveauHierarchique])
  @@index([departementId])
}

// ── Métier (infractions, amendes, paiements) ──────────────────────────────────

model InfractionType {
  id                     String   @id @default(uuid())
  code                   String   @unique
  libelle                String
  montantBase            Int // XAF
  convocationObligatoire Boolean  @default(false)
  actif                  Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  fines Fine[]
}

model Driver {
  id                  String    @id @default(uuid())
  nom                 String
  prenom              String
  telephone           String
  dateNaissance       DateTime?
  numeroPermis        String    @unique
  categoriesPermis    String    @default("B") // ex: "A,B,C"
  dateDelivrancePermis DateTime?
  dateExpirationPermis DateTime?
  lieuDelivrance      String?
  photoUrl            String?
  pointsPermis        Int       @default(12)
  permisValide        Boolean   @default(true)
  permisSuspendu      Boolean   @default(false)
  consentement        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt @default(now())

  vehicles     Vehicle[]
  fines        Fine[]
  convocations Convocation[]
}

model Vehicle {
  id        String   @id @default(uuid())
  plaque    String   @unique
  marque    String?
  modele    String?
  couleur   String?
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  createdAt DateTime @default(now())

  fines Fine[]
}

model Fine {
  id        String @id @default(uuid())
  reference String @unique // PV-YYYY-XXXXXX

  officerId String
  officer   User   @relation("OfficerFines", fields: [officerId], references: [id])

  citizenId String?
  citizen   User?   @relation("CitizenFines", fields: [citizenId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  infractionTypeId String
  infractionType   InfractionType @relation(fields: [infractionTypeId], references: [id])

  montantAmende      Int
  montantDeveloppeur Int @default(1000)
  montantMajoration  Int @default(0)
  montantTotal       Int

  latitude      Float?
  longitude     Float?
  adresseApprox String?
  /// Code du département où l'infraction a été constatée (ex : "BRAZZAVILLE").
  departementCode String?
  lieuPrecis      String?

  verbaliseLe  DateTime
  dateEcheance DateTime

  signatureAgent        String?
  signatureContrevenant String?
  refusSignature        Boolean @default(false)
  documentsSeizes       Json?
  convocationRequise    Boolean @default(false)

  status FineStatus @default(PENDING)
  pdfUrl String?

  deviceId  String?
  synchedAt DateTime?

  payment     Payment?
  convocation Convocation?
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officerId])
  @@index([status])
  @@index([verbaliseLe])
}

model Payment {
  id     String @id @default(uuid())
  fineId String @unique
  fine   Fine   @relation(fields: [fineId], references: [id])

  montantTotal Int
  mode         PaymentMode @default(MOBILE_MONEY)

  operateur     String?
  telephone     String?
  transactionId String? @unique

  quittanceNumero String?
  quittanceDate   DateTime?
  agentTresor     String?

  status      PaymentStatus @default(PENDING)
  initiatedAt DateTime      @default(now())
  confirmedAt DateTime?

  repartition Repartition?

  @@index([transactionId])
  @@index([quittanceNumero])
}

model Repartition {
  id        String  @id @default(uuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  partDeveloppeur Int
  partAgent       Int
  partPolice      Int
  partTresor      Int

  developpeurVerse Boolean @default(false)
  agentVerse       Boolean @default(false)
  policeVerse      Boolean @default(false)
  tresorVerse      Boolean @default(false)

  createdAt DateTime @default(now())
}

model Convocation {
  id       String @id @default(uuid())
  fineId   String @unique
  fine     Fine   @relation(fields: [fineId], references: [id])
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  motif           String
  dateConvocation DateTime
  lieu            String

  sms1SentAt DateTime?
  sms2SentAt DateTime?
  status     ConvocationStatus @default(PENDING)
  appearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String
  body  String
  type  String
  read  Boolean @default(false)
  data  Json?

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  fineId String?
  fine   Fine?   @relation(fields: [fineId], references: [id])

  action    String
  details   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model LicenseVerification {
  id           String   @id @default(uuid())
  numeroPermis String
  valide       Boolean
  details      Json?
  verifiedAt   DateTime @default(now())

  @@index([numeroPermis])
}

model FineCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model Sanction {
  id        String       @id @default(uuid())
  officerId String
  officer   User         @relation("OfficerSanctions", fields: [officerId], references: [id])
  adminId   String
  admin     User         @relation("AdminSanctions", fields: [adminId], references: [id])
  motif     String
  type      SanctionType
  createdAt DateTime     @default(now())

  @@index([officerId])
}
